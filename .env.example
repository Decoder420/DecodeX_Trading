# Groww Trade API Credentials
# NOTE: Secrets live ONLY in .env and are never logged, printed or committed.
# Keys reset daily at 6:00 AM IST.
GROWW_API_KEY=your_groww_api_key
GROWW_API_SECRET=your_groww_api_secret
GROWW_TOTP_SECRET=your_groww_totp_secret

# Angel One SmartAPI Credentials
ANGEL_API_KEY=your_smartapi_api_key
ANGEL_CLIENT_ID=your_client_id
ANGEL_MPIN=your_mpin
ANGEL_TOTP_SECRET=your_base32_totp_secret

# Upstox API Credentials (Optional / Future adapter)
UPSTOX_API_KEY=your_upstox_api_key
UPSTOX_API_SECRET=your_upstox_api_secret
UPSTOX_REDIRECT_URI=https://127.0.0.1:5000/
